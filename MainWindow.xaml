<Window x:Class="SystemCare20.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axiora SystemCare" Icon="/Assets/app.ico" Height="820" Width="1240" MinWidth="1024" MinHeight="700"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI Variable Text, Segoe UI" NumberSubstitution.Substitution="European">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Title bar ===== -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0">
                    <Image Source="/Assets/logo-mark.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"><Run Text="Axiora" FontWeight="Bold" Foreground="{DynamicResource BrandPurpleBrush}"/><Run Text=" SystemCare" FontWeight="SemiBold" Foreground="{DynamicResource BrandAmberBrush}"/></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLang" Style="{StaticResource ChromeButton}" Width="auto" FontFamily="Segoe UI" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnLang_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.lang_switch}" Margin="8,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnWidget" Style="{StaticResource ChromeButton}" Width="auto" Padding="12,0" FontFamily="Segoe UI" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnWidget_Click" ToolTip="{DynamicResource S.perf_monitor_tip}">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.perf_monitor}" Margin="8,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMin_Click"/>
                    <Button x:Name="BtnMax" Style="{StaticResource ChromeButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMax_Click"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- live metrics -->
                <Border DockPanel.Dock="Bottom" Margin="14" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.live_system}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="{DynamicResource S.cpu}" Style="{StaticResource Muted}"/><TextBlock x:Name="SideCpuText" Text="0%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
                        <ProgressBar x:Name="SideCpuBar" Style="{StaticResource SlimProgress}" Margin="0,4,0,8" Maximum="100"/>
                        <Grid><TextBlock Text="{DynamicResource S.memory}" Style="{StaticResource Muted}"/><TextBlock x:Name="SideRamText" Text="0%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
                        <ProgressBar x:Name="SideRamBar" Style="{StaticResource SlimProgress}" Margin="0,4,0,8" Maximum="100"/>
                        <Grid><TextBlock x:Name="SideDiskLabel" Text="Disk C:" Style="{StaticResource Muted}"/><TextBlock x:Name="SideDiskText" Text="0%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
                        <ProgressBar x:Name="SideDiskBar" Style="{StaticResource SlimProgress}" Margin="0,4,0,0" Maximum="100"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,14,0,0">
                    <RadioButton x:Name="NavCare" Style="{StaticResource NavButton}" Tag="care" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BE;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_care}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="clean" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_clean}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="disk" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_disk}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="speed" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_speed}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="protect" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_protect}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="updater" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_updater}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="action" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_action}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.nav_settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- ================= CARE ================= -->
            <Grid x:Name="CarePanel">
                <!-- Idle -->
                <ScrollViewer x:Name="CareIdle">
                    <StackPanel Margin="32,26">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.care_title}" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="LastScanText" Text="{DynamicResource S.no_scans}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeAi" Style="{StaticResource Segment}" GroupName="ScanMode" Content="{DynamicResource S.ai_mode}" IsChecked="True" Checked="ScanMode_Checked"/>
                                    <RadioButton x:Name="ModeManual" Style="{StaticResource Segment}" GroupName="ScanMode" Content="{DynamicResource S.manual_mode}" Checked="ScanMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,26,0,26">
                            <Ellipse Width="230" Height="230" Stroke="{DynamicResource AccentHaloBrush}" StrokeThickness="18"/>
                            <Ellipse Width="196" Height="196" Stroke="{DynamicResource AccentRingBrush}" StrokeThickness="2"/>
                            <Button x:Name="BtnScan" Width="170" Height="170" Cursor="Hand" Click="BtnScan_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="e" Fill="{DynamicResource AccentGradient}">
                                                <Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/></Ellipse.Effect>
                                            </Ellipse>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource S.scan_big}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}"/>
                                                <TextBlock x:Name="ScanSub" Text="{DynamicResource S.ai_plan}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" Opacity="0.85"/>
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Opacity" Value="0.9"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource S.modules}" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="ChkSelectAll" Content="{DynamicResource S.select_all}" HorizontalAlignment="Right" Click="ChkSelectAll_Click"/>
                        </Grid>
                        <UniformGrid x:Name="ModuleGrid" Columns="4"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Progress -->
                <Grid x:Name="CareProgress" Visibility="Collapsed" Margin="32,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Grid Width="220" Height="220">
                            <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="14"/>
                            <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentGradient}" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProgressPct" Text="0%" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource S.scanning}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ProgressModule" Text="" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,22,0,4"/>
                        <TextBlock x:Name="ProgressPath" Text="" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="320"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button x:Name="BtnPause" Style="{StaticResource GhostButton}" Content="{DynamicResource S.pause}" Width="96" Click="BtnPause_Click"/>
                            <Button Style="{StaticResource DangerButton}" Content="{DynamicResource S.stop}" Width="96" Margin="10,0,0,0" Click="BtnStop_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.scan_log}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="ScanLogScroll"><StackPanel x:Name="ScanLog"/></ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Results -->
                <Grid x:Name="CareResults" Visibility="Collapsed" Margin="32,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.results_title}" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="ResultsSubtitle" Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Width="180" Height="180" Margin="0,6">
                                    <Ellipse Stroke="{DynamicResource AmberBrush}" StrokeThickness="12" Opacity="0.85"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ResultsJunk" Text="0 MB" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S.to_clean}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ResultsIssues" Text="" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="18,0,0,0">
                            <ScrollViewer><StackPanel x:Name="ResultsList"/></ScrollViewer>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.back}" Width="100" Click="BtnBackToIdle_Click"/>
                        <Button x:Name="BtnFix" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.fix}" Width="160" FontSize="15" Margin="10,0,0,0" Click="BtnFix_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Success -->
                <StackPanel x:Name="CareSuccess" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="110" Height="110" CornerRadius="55" Background="{DynamicResource GreenSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource S.success_title}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,22,0,6"/>
                    <TextBlock x:Name="SuccessDetail" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.done}" Width="140" Margin="0,24,0,0" Click="BtnBackToIdle_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= CUSTOM CLEAN ================= -->
            <Grid x:Name="CleanPanel" Visibility="Collapsed" Margin="32,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.nav_clean}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource S.clean_sub}" Style="{StaticResource Muted}" Margin="0,4,0,16"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource S.location}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CleanLocation" MinWidth="190" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.browse}" Margin="6,0,18,0" Padding="10,5" Click="BtnBrowseFolder_Click"/>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="3" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CleanDupMode" Style="{StaticResource Segment}" GroupName="CleanMode" Content="{DynamicResource S.dup_files}" IsChecked="True"/>
                                <RadioButton x:Name="CleanLargeMode" Style="{StaticResource Segment}" GroupName="CleanMode" Content="{DynamicResource S.large_files}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource S.match}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CleanMatch" SelectedIndex="1" VerticalAlignment="Center" Margin="0,0,18,0">
                            <ComboBoxItem Content="{DynamicResource S.match_name}"/>
                            <ComboBoxItem Content="{DynamicResource S.match_md5}"/>
                            <ComboBoxItem Content="{DynamicResource S.match_bytes}"/>
                        </ComboBox>
                        <Button x:Name="BtnCleanScan" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.scan}" Width="100" Click="BtnCleanScan_Click"/>
                    </WrapPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <ScrollViewer><StackPanel x:Name="DupTree" Margin="8"/></ScrollViewer>
                        <StackPanel x:Name="CleanBusy" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Width="260"/>
                            <TextBlock x:Name="CleanBusyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" TextWrapping="NoWrap"/>
                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.cancel}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="BtnCleanCancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10">
                    <Grid>
                        <TextBlock x:Name="CleanSelectedText" Text="Selected: 0 files · 0 B" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.recycle}" Click="BtnRecycle_Click"/>
                            <Button Style="{StaticResource DangerButton}" Content="{DynamicResource S.delete_perm}" Margin="10,0,0,0" Click="BtnDeletePermanent_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= DISK SPACE ================= -->
            <Grid x:Name="DiskPanel" Visibility="Collapsed" Margin="32,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.nav_disk}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource S.disk_sub}" Style="{StaticResource Muted}" Margin="0,4,0,16"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource S.location}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DiskTarget" MinWidth="200" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.browse}" Margin="6,0,12,0" Padding="10,5" Click="BtnDiskBrowse_Click"/>
                        <Button x:Name="BtnDiskScan" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.disk_analyze}" Click="BtnDiskScan_Click"/>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="3" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DiskViewFolders" Style="{StaticResource Segment}" GroupName="DiskView" Content="{DynamicResource S.disk_folders}" IsChecked="True" Checked="DiskView_Click"/>
                                <RadioButton x:Name="DiskViewFiles" Style="{StaticResource Segment}" GroupName="DiskView" Content="{DynamicResource S.disk_largest}" Checked="DiskView_Click"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="DiskSummary" FontWeight="SemiBold" FontSize="13.5"/>
                            <TextBlock x:Name="DiskScanInfo" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="DiskUsageBar" Style="{StaticResource SlimProgress}" Maximum="100" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DockPanel>
                            <Grid x:Name="DiskNavBar" DockPanel.Dock="Top" Margin="12,10,12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnDiskUp" Style="{StaticResource GhostButton}" Padding="10,4" Click="BtnDiskUp_Click" ToolTip="{DynamicResource S.disk_up}">
                                        <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <TextBlock x:Name="DiskPath" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="BtnDiskOpenHere" Style="{StaticResource GhostButton}" Content="{DynamicResource S.open_explorer}" Padding="10,4" HorizontalAlignment="Right" Click="BtnDiskOpenHere_Click"/>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}"/>
                            <ScrollViewer x:Name="DiskScroll"><StackPanel x:Name="DiskList" Margin="4,4,4,8"/></ScrollViewer>
                        </DockPanel>
                        <StackPanel x:Name="DiskBusy" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Width="280"/>
                            <TextBlock x:Name="DiskBusyCount" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                            <TextBlock x:Name="DiskBusyPath" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.cancel}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="BtnDiskCancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= SPEED UP ================= -->
            <ScrollViewer x:Name="SpeedPanel" Visibility="Collapsed">
                <StackPanel Margin="32,26">
                    <TextBlock Text="{DynamicResource S.nav_speed}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource S.speed_sub}" Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S.turbo}" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TurboToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Turbo_Changed"/>
                                </Grid>
                                <TextBlock x:Name="TurboDesc" Style="{StaticResource Muted}" Margin="0,10,0,14"/>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TurboWork" Style="{StaticResource Segment}" GroupName="Turbo" Content="{DynamicResource S.work_mode}" Click="Turbo_Changed"/>
                                        <RadioButton x:Name="TurboGame" Style="{StaticResource Segment}" GroupName="Turbo" Content="{DynamicResource S.game_mode}" Click="Turbo_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Accent2Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource S.memory}" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,12,0,6">
                                    <TextBlock x:Name="SpeedRamPct" Text="0%" FontSize="30" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpeedRamDetail" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <ProgressBar x:Name="SpeedRamBar" Style="{StaticResource SlimProgress}" Maximum="100"/>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock x:Name="RamCleanResult" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCleanRam" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.clean_ram}" HorizontalAlignment="Right" Click="BtnCleanRam_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,24,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.startup_opt}" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="StartupSummary" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.refresh}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnStartupRefresh_Click"/>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel x:Name="StartupList"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= PROTECT ================= -->
            <ScrollViewer x:Name="ProtectPanel" Visibility="Collapsed">
                <StackPanel Margin="32,26">
                    <TextBlock Text="{DynamicResource S.nav_protect}" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="ProtectSummary" Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                    <StackPanel x:Name="ShieldList"/>

                    <TextBlock Text="{DynamicResource S.shredder}" Style="{StaticResource H2}" Margin="0,18,0,10"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.shredder_d}" Style="{StaticResource Muted}" MaxWidth="560" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="ShredStatus" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnShred" Style="{StaticResource DangerButton}" Content="{DynamicResource S.shred_choose}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnShred_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= UPDATER ================= -->
            <ScrollViewer x:Name="UpdaterPanel" Visibility="Collapsed">
                <StackPanel Margin="32,26">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.nav_updater}" Style="{StaticResource H1}"/>
                            <TextBlock Text="{DynamicResource S.upd_sub}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="BtnCheckUpdates" Style="{StaticResource GhostButton}" Content="{DynamicResource S.check_updates}" Click="BtnCheckUpdates_Click"/>
                            <Button x:Name="BtnUpdateAll" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.update_all}" Margin="10,0,0,0" Click="BtnUpdateAll_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,18,0,14">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdaterSummary" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock x:Name="UpdaterStatus" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <ProgressBar x:Name="UpdaterProgress" Style="{StaticResource SlimProgress}" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel x:Name="UpdateList"/>
                    </Border>
                    <TextBlock Text="{DynamicResource S.upd_note}" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= ACTION CENTER ================= -->
            <ScrollViewer x:Name="ActionPanel" Visibility="Collapsed">
                <StackPanel Margin="32,26">
                    <TextBlock Text="{DynamicResource S.nav_action}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource S.action_sub}" Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.history}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <StackPanel x:Name="HistoryList"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource S.local_db}" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.refresh}" Padding="10,5" Click="BtnDbRefresh_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.open_data}" Padding="10,5" Margin="8,0,0,0" Click="BtnDbFolder_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="DbJson" FlowDirection="LeftToRight" IsReadOnly="True" Height="260" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource CodeBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= SETTINGS ================= -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource BgBrush}">
            <StackPanel Margin="32,26">
                <TextBlock Text="{DynamicResource S.nav_settings}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource S.settings_sub}" Style="{StaticResource Muted}" Margin="0,4,0,18"/>

                <Border Style="{StaticResource Card}" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Image Source="/Assets/logo-full.png" Height="120" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="24" FlowDirection="LeftToRight" HorizontalAlignment="Left"><Run Text="Axiora" FontWeight="Bold" Foreground="{DynamicResource BrandPurpleBrush}"/><Run Text=" SystemCare" FontWeight="SemiBold" Foreground="{DynamicResource BrandAmberBrush}"/></TextBlock>
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                            <TextBlock Text="{DynamicResource S.about_d}" Style="{StaticResource Muted}" MaxWidth="560" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource S.appearance}" Style="{StaticResource H2}" Margin="0,24,0,2"/>
                <TextBlock Text="{DynamicResource S.appearance_d}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                <WrapPanel x:Name="ThemeList"/>

                <TextBlock Text="{DynamicResource S.language}" Style="{StaticResource H2}" Margin="0,18,0,10"/>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="Lang" Content="English" Click="LangRadio_Click"/>
                        <RadioButton x:Name="LangAr" Style="{StaticResource Segment}" GroupName="Lang" Content="العربية" Click="LangRadio_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12"
                Visibility="Collapsed" MaxWidth="380">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
            <StackPanel>
                <TextBlock x:Name="ToastTitle" FontWeight="SemiBold"/>
                <TextBlock x:Name="ToastBody" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
